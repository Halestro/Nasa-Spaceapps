# --- Supabase (Project Settings -> API) ---
# SUPABASE_URL   e.g. https://abcdefgh.supabase.co
# SUPABASE_KEY   service_role key — server only, NEVER shipped to the browser
# SUPABASE_ANON_KEY  anon key — used server-side to validate Supabase Auth tokens
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=

# --- Frontend (frontend/.env) ---
# VITE_SUPABASE_URL       same as SUPABASE_URL
# VITE_SUPABASE_ANON_KEY  same as SUPABASE_ANON_KEY (anon key is safe in the browser)
